# Copia este archivo a ".env" y completa tus valores.
# Si dejas ANTHROPIC_API_KEY vacia, el agente funciona igual en modo local
# (banco de vocabulario propio), sin generar preguntas con IA en vivo.

ANTHROPIC_API_KEY=

# Cualquier string random sirve; se usa para firmar la cookie de sesion.
FLASK_SECRET=cambiar-por-un-valor-random
